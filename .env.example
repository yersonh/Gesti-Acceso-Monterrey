# ══════════════════════════════════════════════════════════════
# SISTEMA DE GESTIÓN DE VISITAS — Alcaldía de Monterrey, Casanare
# Copia este archivo como .env y llena cada valor antes de
# levantar el servidor con: docker compose up -d
# ══════════════════════════════════════════════════════════════


# ── Aplicación ────────────────────────────────────────────────
# URL pública del servidor, sin barra final.
# Se usa para construir los links de valoración y reprogramación
# que se envían por correo y WhatsApp.
APP_URL=https://visitas.alcaldiamonterrey.gov.co


# ── Base de datos (PostgreSQL) ─────────────────────────────────
# Cadena de conexión completa. El contenedor de la app la usa
# para conectarse al contenedor de Postgres.
DATABASE_URL=postgresql://postgres:CAMBIA_ESTA_CONTRASENA@db:5432/railway

# Credenciales del contenedor PostgreSQL (deben coincidir con DATABASE_URL)
POSTGRES_DB=railway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA


# ── Correo electrónico (Brevo) ─────────────────────────────────
# Crear cuenta en https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Dirección y nombre que aparece como remitente en los correos
SMTP_FROM=noreply@alcaldiamonterrey.gov.co
SMTP_FROM_NAME=Alcaldía Municipal de Monterrey


# ── WhatsApp Business (Meta Cloud API) ────────────────────────
# Obtener en: https://developers.facebook.com → tu app → WhatsApp → Configuración
#
# Dejar en blanco si aún no está configurado: el sistema usará
# WhatsApp Web (wa.me) como respaldo automáticamente.

# Token de acceso de larga duración (generado en Meta Business Suite)
META_WHATSAPP_TOKEN=

# ID del número de teléfono registrado en Meta (no es el número en sí,
# es el ID interno que asigna Meta, ej: 123456789012345)
META_PHONE_NUMBER_ID=

# Nombre exacto de la plantilla aprobada en Meta Business.
# La plantilla debe tener dos parámetros: {{1}} nombre del ciudadano, {{2}} link.
META_WHATSAPP_TEMPLATE=valoracion_visita
